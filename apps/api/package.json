{
  "name": "@arch-draw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsup src/main.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch-draw/domain": "0.1.0",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.3.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
