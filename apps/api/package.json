{
  "name": "@arch-draw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsup src/main.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arch-draw/domain": "0.1.0",
    "@aws-sdk/client-ec2": "^3.1052.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1052.0",
    "@aws-sdk/client-lambda": "^3.1052.0",
    "@aws-sdk/client-rds": "^3.1052.0",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/client-sts": "^3.1052.0",
    "@aws-sdk/credential-providers": "^3.1052.0",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.3.2",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
